        }
      },
      "source": [
        "## 10. Ejemplos Prácticos Basados en el Código\n",
        "\n",
        "### 10.1 Ejemplo: Creación de Formas Geométricas\n",
        "```python\n",
        "class FormasGeometricas(Scene):\n",
        "    def construct(self):\n",
        "        # Crear formas básicas\n",
        "        circulo = Circle(radius=1, color=BLUE)\n",
        "        cuadrado = Square(side_length=2, color=RED)\n",
        "        triangulo = Triangle(color=GREEN)\n",
        "        \n",
        "        # Posicionar\n",
        "        cuadrado.next_to(circulo, RIGHT)\n",
        "        triangulo.next_to(circulo, LEFT)\n",
        "        \n",
        "        # Animar creación\n",
        "        self.play(Create(circulo))\n",
        "        self.play(Create(cuadrado))\n",
        "        self.play(Create(triangulo))\n",
        "        self.wait()\n",
        "```\n",
        "\n",
        "### 10.2 Ejemplo: Texto y Matemáticas\n",
        "```python\n",
        "class TextoMatematico(Scene):\n",
        "    def construct(self):\n",
        "        # Texto simple\n",
        "        titulo = Text(\"Análisis Matemático\", font_size=48)\n",
        "        \n",
        "        # Ecuación LaTeX\n",
        "        ecuacion = MathTex(r\"f(x) = x^2 + 2x + 1\")\n",
        "        \n",
        "        # Número animado\n",
        "        numero = DecimalNumber(0, num_decimal_places=2)\n",
        "        \n",
        "        # Posicionar\n",
        "        titulo.to_edge(UP)\n",
        "        ecuacion.next_to(titulo, DOWN)\n",
        "        numero.next_to(ecuacion, DOWN)\n",
        "        \n",
        "        # Animar\n",
        "        self.play(Write(titulo))\n",
        "        self.play(Write(ecuacion))\n",
        "        self.play(ChangeDecimalToValue(numero, 3.14))\n",
        "        self.wait()\n",
        "```\n"
      ]
    },
    {
      "cell_type": "raw",
      "metadata": {
        "vscode": {
          "languageId": "raw"
        }
      },
      "source": [
        "### 10.3 Ejemplo: Transformaciones y Movimientos\n",
        "```python\n",
        "class Transformaciones(Scene):\n",
        "    def construct(self):\n",
        "        # Objeto inicial\n",
        "        cuadrado = Square(color=BLUE)\n",
        "        circulo = Circle(color=RED)\n",
        "        \n",
        "        # Transformación\n",
        "        self.play(Create(cuadrado))\n",
        "        self.play(Transform(cuadrado, circulo))\n",
        "        \n",
        "        # Movimientos\n",
        "        self.play(cuadrado.animate.shift(UP))\n",
        "        self.play(cuadrado.animate.rotate(PI/4))\n",
        "        self.play(cuadrado.animate.scale(2))\n",
        "        \n",
        "        # Efectos\n",
        "        self.play(FadeOut(cuadrado))\n",
        "        self.wait()\n",
        "```\n",
        "\n",
        "### 10.4 Ejemplo: Animaciones Simultáneas\n",
        "```python\n",
        "class AnimacionesSimultaneas(Scene):\n",
        "    def construct(self):\n",
        "        # Crear múltiples objetos\n",
        "        objetos = VGroup(\n",
        "            Circle(color=BLUE),\n",
        "            Square(color=RED),\n",
        "            Triangle(color=GREEN)\n",
        "        )\n",
        "        objetos.arrange(RIGHT, buff=1)\n",
        "        \n",
        "        # Animar todos a la vez\n",
        "        self.play(\n",
        "            *[Create(obj) for obj in objetos],\n",
        "            run_time=2\n",
        "        )\n",
        "        \n",
        "        # Transformar todos\n",
        "        self.play(\n",
        "            *[obj.animate.rotate(PI) for obj in objetos],\n",
        "            run_time=1\n",
        "        )\n",
        "        \n",
        "        self.wait()\n",
        "```\n"
      ]
    },
